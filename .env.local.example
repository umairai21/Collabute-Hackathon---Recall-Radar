# Copy to .env.local and fill in. `npx convex dev` will add
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL automatically on first run.

# --- Convex (auto-filled by `npx convex dev`) ---
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=

# --- ElevenLabs Conversational AI ---
# Agent ID from the ElevenLabs dashboard (Conversational AI -> your agent).
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_1001m1931c4wearrcg8mxh3810g9

# --- Context.dev (enrichment) + Resend (email) + Groq (AI summaries) ---
# These are read inside Convex actions (convex/enrich.ts, convex/notify.ts,
# convex/summarize.ts), which run in Convex's cloud and do NOT read
# .env.local. Set each with `npx convex env set NAME value` instead —
# the lines below are just placeholders for reference/local scripts.
CONTEXT_DEV_API_KEY=ctxt_secret_your_key_here
RESEND_API_KEY=re_your_key_here
RECALL_RADAR_ADMIN_EMAIL=you@example.com
RECALL_RADAR_FROM_EMAIL=Recall Radar <onboarding@resend.dev>
RECALL_RADAR_APP_URL=http://localhost:3000
GROQ_API_KEY=gsk_your_key_here
